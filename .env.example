# Copy this file to `.env` and fill in your values. `.env` is gitignored — never commit it.
# Get a free Groq key (no credit card) at https://console.groq.com  ->  API Keys.

GROQ_API_KEY=

# Set after the G0 bakeoff picks the winner (openai/gpt-oss-120b or qwen/qwen3.6-27b)
MODEL_ID=openai/gpt-oss-120b

# Sentence encoder for retrieval. LaBSE is the default in code and is what the reported
# numbers were measured with. BGE-M3 was the planned model but is a ~2.3 GB download; only
# set this if you have fetched it AND rebuilt the index (python tools/indexer.py).
# EMBED_MODEL=sentence-transformers/LaBSE

# Forces UTF-8 for Arabic on Windows consoles
PYTHONIOENCODING=utf-8
